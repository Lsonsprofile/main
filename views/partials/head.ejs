<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Web Development Learning Platform' %></title>
  <% if (typeof seoDescription !== 'undefined' && seoDescription) { %>
  <meta name="description" content="<%= seoDescription %>">
  <% } else { %>
  <meta name="description" content="Progressive 36-week web development curriculum. Learn HTML, CSS, and JavaScript with structured lessons.">
  <% } %>
  <meta name="theme-color" content="#1a56db">
  <!-- Open Graph -->
  <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Web Development Learning Platform' %>">
  <meta property="og:description" content="<%= typeof seoDescription !== 'undefined' && seoDescription ? seoDescription : 'Progressive 36-week web development curriculum.' %>">
  <meta property="og:type" content="website">
  <% if (typeof page !== 'undefined' && page && page.slug) { %>
  <link rel="canonical" href="/lesson/<%= page.slug %>">
  <% } %>
  <link rel="stylesheet" href="/css/main.css">
  <% if (typeof extraStyles !== 'undefined') { %>
    <%- extraStyles %>
  <% } %>
</head>
<body>
