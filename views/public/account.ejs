<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
  const avatar = user.avatarUrl || '';
  const initial = user.name ? String(user.name).charAt(0).toUpperCase() : 'U';
  const progress = typeof progress !== 'undefined' && progress ? progress : { completed: [], completedCount: 0, totalLessons: 0 };
  const roleLabel = user.role === 'admin' ? 'Administrator' : 'Learner';
  const completed = progress.completedCount || 0;
  const total = progress.totalLessons || 0;
  const remaining = Math.max(0, total - completed);
%>

<main id="main-content" class="pf-page">
  <% if (success === 'updated') { %>
    <div class="pf-alert pf-alert-ok">Profile updated.</div>
  <% } %>
  <% if (error === 'name') { %>
    <div class="pf-alert pf-alert-err">Name must be at least 2 characters.</div>
  <% } %>
  <% if (error === 'image') { %>
    <div class="pf-alert pf-alert-err">Please upload a valid image (jpg, png, gif, or webp, max 3MB).</div>
  <% } %>

  <!-- Top identity card -->
  <section class="pf-card pf-identity">
    <div class="pf-identity-left">
      <div class="pf-avatar" id="pf-avatar-display">
        <% if (avatar) { %>
          <img src="<%= avatar %>" alt="<%= user.name %>" class="pf-avatar-img" id="pf-hero-img">
        <% } else { %>
          <span class="pf-avatar-fallback" id="pf-hero-fallback"><%= initial %></span>
          <img src="" alt="" class="pf-avatar-img" id="pf-hero-img" hidden>
        <% } %>
      </div>
      <div class="pf-identity-text">
        <h1 class="pf-name"><%= user.name || 'User' %></h1>
        <p class="pf-role"><%= roleLabel %></p>
        <ul class="pf-meta">
          <li><span class="pf-meta-label">Email</span> <%= user.email || '—' %></li>
          <li><span class="pf-meta-label">Role</span> <%= roleLabel %></li>
        </ul>
        <div class="pf-actions">
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="pf-btn pf-btn-primary">Dashboard</a>
          <% } else { %>
            <a href="/" class="pf-btn pf-btn-primary">Home</a>
          <% } %>
          <form action="/logout" method="POST" class="pf-inline">
            <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
            <button type="submit" class="pf-btn pf-btn-ghost">Log out</button>
          </form>
        </div>
      </div>
    </div>
    <div class="pf-identity-stats">
      <div class="pf-stat">
        <span class="pf-stat-num"><%= completed %></span>
        <span class="pf-stat-label">Completed</span>
      </div>
      <div class="pf-stat">
        <span class="pf-stat-num"><%= total %></span>
        <span class="pf-stat-label">Lessons</span>
      </div>
      <div class="pf-stat">
        <span class="pf-stat-num"><%= remaining %></span>
        <span class="pf-stat-label">Remaining</span>
      </div>
    </div>
  </section>

  <!-- About / progress cards -->
  <h2 class="pf-section-title">Learning overview</h2>
  <div class="pf-about-grid">
    <article class="pf-card pf-mini">
      <h3>Completed</h3>
      <p class="pf-big-num pf-blue"><%= completed %></p>
      <p class="pf-mini-sub">lessons finished</p>
    </article>
    <article class="pf-card pf-mini">
      <h3>Catalogue</h3>
      <p class="pf-big-num pf-blue"><%= total %></p>
      <p class="pf-mini-sub">lessons listed</p>
    </article>
    <article class="pf-card pf-mini">
      <h3>Progress</h3>
      <div class="pf-ring-row">
        <span class="pf-ring pf-ring-green"><%= completed %></span>
        <span class="pf-ring pf-ring-blue"><%= remaining %></span>
      </div>
      <p class="pf-legend"><span class="pf-dot green"></span> done · <span class="pf-dot blue"></span> left</p>
    </article>
  </div>

  <!-- Edit form -->
  <section class="pf-card pf-edit">
    <h2 class="pf-section-title" style="margin-top:0;">Edit profile</h2>
    <p class="pf-lead">Update your display name and profile picture. Email cannot be changed here.</p>

    <form action="/account" method="POST" enctype="multipart/form-data" class="pf-form">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

      <div class="pf-form-row">
        <div class="pf-photo-block">
          <div class="pf-avatar pf-avatar-sm" id="avatar-preview-wrap">
            <% if (avatar) { %>
              <img src="<%= avatar %>" alt="" class="pf-avatar-img" id="avatar-preview-img">
            <% } else { %>
              <span class="pf-avatar-fallback" id="avatar-preview-fallback"><%= initial %></span>
              <img src="" alt="" class="pf-avatar-img" id="avatar-preview-img" hidden>
            <% } %>
          </div>
          <div>
            <label for="avatar" class="pf-file-label">Change photo</label>
            <input type="file" id="avatar" name="avatar" accept="image/jpeg,image/png,image/gif,image/webp" class="pf-file">
            <small class="pf-hint">JPG, PNG, GIF or WebP · max 3MB · square works best</small>
          </div>
        </div>
      </div>

      <div class="pf-form-grid">
        <div class="form-group">
          <label for="name">Display name</label>
          <input type="text" id="name" name="name" required minlength="2" maxlength="100" value="<%= user.name || '' %>">
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" value="<%= user.email || '' %>" disabled>
        </div>
      </div>

      <button type="submit" class="pf-btn pf-btn-primary">Save profile</button>
    </form>
  </section>

  <% if (progress.completed && progress.completed.length) { %>
    <section class="pf-card">
      <h2 class="pf-section-title" style="margin-top:0;">Completed lessons</h2>
      <ul class="pf-lesson-list">
        <% progress.completed.forEach(function(p) { %>
          <li>
            <a href="/lesson/<%= p.slug %>">
              <% if (p.weekNumber) { %><span class="pf-badge">Week <%= p.weekNumber %></span><% } %>
              <strong><%= p.title %></strong>
            </a>
          </li>
        <% }) %>
      </ul>
    </section>
  <% } %>
</main>

<script>
(function () {
  var input = document.getElementById('avatar');
  var img = document.getElementById('avatar-preview-img');
  var fallback = document.getElementById('avatar-preview-fallback');
  var heroImg = document.getElementById('pf-hero-img');
  var heroFallback = document.getElementById('pf-hero-fallback');
  if (!input || !img) return;
  input.addEventListener('change', function () {
    var file = input.files && input.files[0];
    if (!file) return;
    var url = URL.createObjectURL(file);
    img.src = url;
    img.hidden = false;
    if (fallback) fallback.hidden = true;
    if (heroImg) {
      heroImg.src = url;
      heroImg.hidden = false;
    }
    if (heroFallback) heroFallback.hidden = true;
  });
})();
</script>

<%- include('../partials/footer') %>
