<%- include('../partials/head') %>
<%
  const custom = typeof isCustomHtml !== 'undefined' && isCustomHtml;
%>
<% if (custom && page.htmlSource) { %>
  <%- /* custom HTML is served as full document from controller; this branch is fallback */ %>
  <main id="main-content" class="custom-html-page">
    <%- include('../partials/custom-html-frame', { htmlSource: page.htmlSource || '', slug: page.slug || '' }) %>
  </main>
<% } else { %>
<main id="main-content" class="container site-page">
  <% if (typeof isPlaceholder !== 'undefined' && isPlaceholder) { %>
    <div class="placeholder-page">
      <h1><%= page.title || 'Page' %></h1>
      <p class="lead">This page is not set up yet.</p>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <p>
          <a class="btn btn-primary" href="/admin/pages">Create or edit pages in Admin</a>
          <% if (page.slug === 'home') { %>
            <a class="btn btn-secondary" href="/admin/home">Edit homepage</a>
          <% } %>
        </p>
      <% } else { %>
        <p class="text-muted">This page is not ready yet. Please check back later.</p>
        <p style="display:flex;flex-wrap:wrap;gap:0.75rem;margin-top:1rem;">
          <a class="btn btn-primary" href="/">Go to home</a>
          <% if (typeof isAuthenticated === 'undefined' || !isAuthenticated) { %>
            <a class="btn btn-secondary" href="/login">Login</a>
          <% } else { %>
            <a class="btn btn-secondary" href="/account">My profile</a>
          <% } %>
        </p>
      <% } %>
    </div>
  <% } else { %>
    <article>
      <header class="page-header">
        <h1><%= page.title %></h1>
        <% if (page.description) { %><p class="lead"><%= page.description %></p><% } %>
      </header>
      <div class="page-body">
        <% (contentBlocks || []).forEach(function(block) { %>
          <%- include('../partials/render-block', { block: block, root: true }) %>
        <% }) %>
        <% if (!contentBlocks || !contentBlocks.length) { %>
          <p class="text-muted">No content on this page yet.</p>
        <% } %>
      </div>
    </article>
  <% } %>
</main>
<% } %>
