<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main-content" class="container" style="padding:3rem 1.25rem;max-width:36rem;">
  <h1>Access restricted</h1>
  <p class="lead">You do not have permission to open this page.</p>
  <p style="display:flex;flex-wrap:wrap;gap:0.75rem;">
    <a class="btn btn-primary" href="/">Go to home</a>
    <% if (typeof isAuthenticated === 'undefined' || !isAuthenticated) { %>
      <a class="btn btn-secondary" href="/login">Login</a>
    <% } else if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <a class="btn btn-secondary" href="/admin">Dashboard</a>
    <% } else { %>
      <a class="btn btn-secondary" href="/account">My profile</a>
    <% } %>
  </p>
</main>

<%- include('../partials/footer') %>
