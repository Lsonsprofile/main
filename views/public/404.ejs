<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<main id="main-content" class="container" style="padding:3rem 1.25rem;max-width:36rem;">
  <h1>This page is not available</h1>
  <p class="lead">The link may be wrong, or the page has not been published yet.</p>
  <p style="display:flex;flex-wrap:wrap;gap:0.75rem;">
    <a class="btn btn-primary" href="/">Go to home</a>
    <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
      <a class="btn btn-secondary" href="/admin/pages">Manage pages</a>
    <% } else if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
      <a class="btn btn-secondary" href="/account">My profile</a>
    <% } else { %>
      <a class="btn btn-secondary" href="/login">Login</a>
      <a class="btn btn-secondary" href="/register">Sign up</a>
    <% } %>
  </p>
</main>

<%- include('../partials/footer') %>
