<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<%
  const avatar = (user && user.avatarUrl) ? user.avatarUrl : '';
  const initial = (user && user.name) ? String(user.name).charAt(0).toUpperCase() : 'U';
  const roleLabel = (user && user.role === 'admin') ? 'Administrator' : 'Learner';
  const progressData = (typeof progress !== 'undefined' && progress) ? progress : { completed: [], completedCount: 0, totalLessons: 0 };
  const completed = progressData.completedCount || 0;
  const total = progressData.totalLessons || 0;
  const remaining = Math.max(0, total - completed);
  const themeVal = (typeof theme !== 'undefined' && theme === 'dark') ? 'dark' : 'light';
%>

<main id="main-content" class="acct">
  <% if (success === 'updated') { %>
    <div class="acct-alert acct-alert-ok">Settings saved.</div>
  <% } %>
  <% if (success === 'avatar-removed') { %>
    <div class="acct-alert acct-alert-ok">Profile photo removed.</div>
  <% } %>
  <% if (error === 'name') { %>
    <div class="acct-alert acct-alert-err">Name must be at least 2 characters.</div>
  <% } %>
  <% if (error === 'image') { %>
    <div class="acct-alert acct-alert-err">Use a valid image (jpg, png, gif, webp · max 3MB).</div>
  <% } %>
  <% if (error && error !== 'name' && error !== 'image') { %>
    <div class="acct-alert acct-alert-err"><%= error %></div>
  <% } %>

  <header class="acct-top">
    <div class="acct-top-left">
      <div class="acct-avatar" id="acct-avatar">
        <% if (avatar) { %>
          <img src="<%= avatar %>" alt="" class="acct-avatar-img" id="acct-avatar-img">
        <% } else { %>
          <span class="acct-avatar-fallback" id="acct-avatar-fallback"><%= initial %></span>
        <% } %>
      </div>
      <div>
        <h1 class="acct-name"><%= user.name || 'User' %></h1>
        <p class="acct-role"><%= roleLabel %> · <%= user.email || '' %></p>
      </div>
    </div>
    <div class="acct-stats">
      <div class="acct-stat"><strong><%= completed %></strong><span>Done</span></div>
      <div class="acct-stat"><strong><%= total %></strong><span>Lessons</span></div>
      <div class="acct-stat"><strong><%= remaining %></strong><span>Left</span></div>
    </div>
  </header>

  <div class="acct-grid">
    <section class="acct-card">
      <h2>Profile</h2>
      <form action="/account/settings" method="POST" enctype="multipart/form-data" id="acct-form">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">

        <div class="acct-photo-row">
          <div class="acct-avatar acct-avatar-sm" id="avatar-preview-wrap">
            <% if (avatar) { %>
              <img src="<%= avatar %>" alt="" class="acct-avatar-img" id="avatar-preview-img">
            <% } else { %>
              <span class="acct-avatar-fallback" id="avatar-preview-fallback"><%= initial %></span>
            <% } %>
          </div>
          <div class="acct-photo-actions">
            <label class="acct-file-btn">
              Change photo
              <input type="file" name="avatar" id="avatar-input" accept="image/jpeg,image/png,image/gif,image/webp">
            </label>
            <% if (avatar) { %>
              <button type="button" class="acct-link-btn" id="avatar-remove-btn">Remove</button>
            <% } %>
            <p class="acct-hint">Square image · max 3MB</p>
          </div>
        </div>

        <label class="acct-label" for="name">Display name</label>
        <input class="acct-input" type="text" id="name" name="name" required minlength="2" maxlength="100" value="<%= user.name || '' %>">

        <label class="acct-label" for="email">Email</label>
        <input class="acct-input" type="email" id="email" value="<%= user.email || '' %>" disabled>

        <h2 class="acct-subhead">Appearance</h2>
        <div class="acct-theme">
          <label class="acct-theme-opt">
            <input type="radio" name="theme" value="light" <%= themeVal === 'light' ? 'checked' : '' %>>
            <span class="acct-swatch acct-swatch-light"></span>
            Light
          </label>
          <label class="acct-theme-opt">
            <input type="radio" name="theme" value="dark" <%= themeVal === 'dark' ? 'checked' : '' %>>
            <span class="acct-swatch acct-swatch-dark"></span>
            Dark
          </label>
        </div>

        <div class="acct-actions">
          <button type="submit" class="acct-btn-primary">Save changes</button>
          <% if (user.role === 'admin') { %>
            <a href="/admin" class="acct-btn-ghost">Dashboard</a>
          <% } %>
        </div>
      </form>
      <form id="avatar-remove-form" action="/account/avatar" method="POST" style="display:none">
        <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
        <input type="hidden" name="_method" value="DELETE">
      </form>
    </section>

    <section class="acct-card">
      <h2>Progress</h2>
      <% if (progressData.completed && progressData.completed.length) { %>
        <ul class="acct-list">
          <% progressData.completed.forEach(function (item) { %>
            <li><%= item.title || item.slug || 'Lesson' %></li>
          <% }); %>
        </ul>
      <% } else { %>
        <p class="acct-hint">No completed lessons yet. Open a page and use <strong>Mark complete</strong>.</p>
      <% } %>
    </section>
  </div>
</main>

<style>
  .acct {
    max-width: min(52rem, 100%);
    width: 100%;
    margin: 0 auto;
    padding: 1rem 0.85rem 2.5rem;
    box-sizing: border-box;
    overflow-x: hidden;
  }
  .acct *, .acct *::before, .acct *::after { box-sizing: border-box; }

  .acct-alert {
    border-radius: 10px;
    padding: 0.65rem 0.9rem;
    margin-bottom: 1rem;
    font-size: 0.875rem;
    font-weight: 600;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .acct-alert-ok { background: #ecfdf5; color: #047857; border: 1px solid #a7f3d0; }
  .acct-alert-err { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; }

  .acct-top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: #fff;
    border: 1px solid #e8eef5;
    border-radius: 14px;
    padding: 1rem;
    margin-bottom: 1rem;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.04);
    max-width: 100%;
  }
  .acct-top-left {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-width: 0;
    flex: 1 1 auto;
    max-width: 100%;
  }
  .acct-avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: #e2e8f0;
    border: 2px solid #f1f5f9;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .acct-avatar-sm { width: 44px; height: 44px; }
  .acct-avatar-img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .acct-avatar-fallback { font-size: 1.1rem; font-weight: 800; color: #64748b; line-height: 1; }
  .acct-top-left > div:last-child { min-width: 0; flex: 1 1 auto; }
  .acct-name {
    margin: 0;
    font-size: clamp(1rem, 3.5vw, 1.15rem);
    font-weight: 800;
    color: #0f172a;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .acct-role {
    margin: 0.15rem 0 0;
    font-size: 0.8rem;
    color: #64748b;
    font-weight: 500;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .acct-stats { display: flex; flex-wrap: wrap; gap: 0.85rem 1.25rem; }
  .acct-stat { text-align: center; min-width: 2.75rem; }
  .acct-stat strong { display: block; font-size: 1.1rem; font-weight: 800; color: #2563eb; line-height: 1.2; }
  .acct-stat span { font-size: 0.7rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.03em; }

  .acct-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
    max-width: 100%;
  }
  @media (min-width: 800px) {
    .acct-grid { grid-template-columns: 1.2fr 0.9fr; align-items: start; }
  }

  .acct-card {
    background: #fff;
    border: 1px solid #e8eef5;
    border-radius: 14px;
    padding: 1.1rem 1rem;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.04);
    max-width: 100%;
    min-width: 0;
    overflow: hidden;
  }
  .acct-card h2 { margin: 0 0 0.9rem; font-size: 0.95rem; font-weight: 800; color: #0f172a; }
  .acct-subhead { margin: 1rem 0 0.55rem; font-size: 0.85rem; font-weight: 700; color: #334155; }
  .acct-label { display: block; font-size: 0.75rem; font-weight: 700; color: #64748b; margin: 0.65rem 0 0.3rem; }
  .acct-input {
    display: block;
    width: 100%;
    max-width: 100%;
    padding: 0.55rem 0.7rem;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    font: 500 0.9rem/1.3 system-ui, sans-serif;
    color: #0f172a;
    background: #fff;
  }
  .acct-input:disabled { background: #f8fafc; color: #64748b; }

  .acct-photo-row { display: flex; flex-wrap: wrap; align-items: center; gap: 0.85rem; max-width: 100%; }
  .acct-photo-actions { min-width: 0; flex: 1 1 10rem; }
  .acct-file-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.45rem 0.75rem;
    border-radius: 8px;
    background: #f1f5f9;
    color: #0f172a;
    font: 700 0.78rem/1 system-ui, sans-serif;
    cursor: pointer;
    max-width: 100%;
  }
  .acct-file-btn input[type="file"] {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    overflow: hidden;
  }
  .acct-link-btn {
    border: 0;
    background: transparent;
    color: #dc2626;
    font: 600 0.78rem/1 system-ui, sans-serif;
    cursor: pointer;
    padding: 0.35rem 0;
  }
  .acct-hint { margin: 0.35rem 0 0; font-size: 0.72rem; color: #94a3b8; overflow-wrap: anywhere; }

  .acct-theme { display: flex; flex-wrap: wrap; gap: 0.65rem; }
  .acct-theme-opt {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
    cursor: pointer;
  }
  .acct-swatch { width: 1.35rem; height: 1.35rem; border-radius: 6px; border: 1px solid #e2e8f0; }
  .acct-swatch-light { background: #f8fafc; }
  .acct-swatch-dark { background: #0f172a; }

  .acct-actions { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1rem; }
  .acct-btn-primary,
  .acct-btn-ghost {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.55rem 1rem;
    border-radius: 10px;
    font: 700 0.85rem/1 system-ui, sans-serif;
    text-decoration: none;
    border: 0;
    cursor: pointer;
    max-width: 100%;
  }
  .acct-btn-primary { background: #2563eb; color: #fff; }
  .acct-btn-ghost { background: #f1f5f9; color: #0f172a; }

  .acct-list { margin: 0; padding: 0; list-style: none; }
  .acct-list li {
    padding: 0.45rem 0;
    border-bottom: 1px solid #f1f5f9;
    font-size: 0.85rem;
    color: #334155;
    overflow-wrap: anywhere;
    word-break: break-word;
  }
  .acct-list li:last-child { border-bottom: 0; }

  @media (max-width: 640px) {
    .acct { padding: 0.75rem 0.65rem 2rem; }
    .acct-top { flex-direction: column; align-items: flex-start; }
    .acct-top-left { width: 100%; }
    .acct-stats { width: 100%; justify-content: space-between; }
    .acct-actions { flex-direction: column; }
    .acct-actions .acct-btn-primary,
    .acct-actions .acct-btn-ghost { width: 100%; }
    .acct-photo-row { flex-direction: column; align-items: flex-start; }
  }

  body { overflow-x: hidden; }
  main#main-content.acct { width: 100%; max-width: min(52rem, 100%); }
</style>

<script>
(function () {
  var input = document.getElementById('avatar-input');
  var previewImg = document.getElementById('avatar-preview-img');
  var previewFallback = document.getElementById('avatar-preview-fallback');
  var wrap = document.getElementById('avatar-preview-wrap');
  if (input && wrap) {
    input.addEventListener('change', function () {
      var file = input.files && input.files[0];
      if (!file) return;
      var url = URL.createObjectURL(file);
      if (previewImg) {
        previewImg.src = url;
      } else if (previewFallback) {
        var img = document.createElement('img');
        img.src = url;
        img.alt = '';
        img.className = 'acct-avatar-img';
        img.id = 'avatar-preview-img';
        previewFallback.replaceWith(img);
      }
    });
  }
  var removeBtn = document.getElementById('avatar-remove-btn');
  var removeForm = document.getElementById('avatar-remove-form');
  if (removeBtn && removeForm) {
    removeBtn.addEventListener('click', function () {
      if (confirm('Remove your profile photo?')) removeForm.submit();
    });
  }
})();
</script>

<%- include('../partials/footer') %>
