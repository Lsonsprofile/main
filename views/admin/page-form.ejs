<%- include('../partials/head') %>

<div class="admin-layout">
  <%- include('../partials/admin-nav') %>

  <main class="admin-main">
    <header class="admin-header">
      <h1><%= isEdit ? 'Edit Page' : 'Create Page' %></h1>
    </header>

    <% if (error) { %>
      <div class="alert alert-error"><%= error %></div>
    <% } %>

    <form action="<%= isEdit ? '/admin/pages/' + page._id : '/admin/pages' %>" method="POST" class="admin-form">
      <input type="hidden" name="_csrf" value="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
      <div class="form-group">
        <label for="title">Title *</label>
        <input type="text" id="title" name="title" required
               value="<%= formData.title || (page && page.title) || '' %>">
      </div>

      <div class="form-group">
        <label for="slug">Slug * (URL)</label>
        <input type="text" id="slug" name="slug"
               value="<%= formData.slug || (page && page.slug) || '' %>"
               placeholder="auto-generated-from-title">
        <small class="form-hint">Only lowercase letters, numbers and hyphens.</small>
        <p class="form-hint" id="slug-url-hint" style="margin-top:0.5rem;">
          After create, your page link will be:
          <code id="slug-url-preview">/lesson/<span id="slug-preview-text">your-slug</span></code>
          (homepage slug <code>home</code> → <code>/</code>)
        </p>
        <script>
        (function(){
          var slug = document.getElementById('slug');
          var title = document.getElementById('title');
          var out = document.getElementById('slug-preview-text');
          function slugify(s){
            return String(s||'').toLowerCase().trim()
              .replace(/[^a-z0-9]+/g,'-').replace(/^-+|-+$/g,'').slice(0,80) || 'your-slug';
          }
          function update(){
            var v = (slug && slug.value) ? slug.value : (title ? slugify(title.value) : 'your-slug');
            v = slugify(v);
            if (out) out.textContent = v === 'home' ? '(use / for home)' : v;
            var code = document.getElementById('slug-url-preview');
            if (code && v === 'home') code.innerHTML = '/';
            else if (code) code.innerHTML = '/lesson/<span id="slug-preview-text">'+v+'</span>';
          }
          if (slug) slug.addEventListener('input', update);
          if (title) title.addEventListener('input', function(){ if (slug && !slug.value) update(); });
          update();
        })();
        </script>
      </div>

      <div class="form-group">
        <label for="description">Description</label>
        <textarea id="description" name="description" rows="3"><%= formData.description || (page && page.description) || '' %></textarea>
      </div>

      <div class="form-group">
        <label for="status">Status</label>
        <select id="status" name="status">
          <option value="draft" <%= (formData.status || (page && page.status)) === 'draft' ? 'selected' : '' %>>Draft</option>
          <option value="published" <%= (formData.status || (page && page.status)) === 'published' ? 'selected' : '' %>>Published</option>
        </select>
      </div>

      <div class="form-group">
        <label for="seoTitle">SEO Title</label>
        <input type="text" id="seoTitle" name="seoTitle"
               value="<%= formData.seoTitle || (page && page.seoTitle) || '' %>">
      </div>

      <div class="form-group">
        <label for="seoDescription">SEO Description</label>
        <textarea id="seoDescription" name="seoDescription" rows="2"><%= formData.seoDescription || (page && page.seoDescription) || '' %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%= isEdit ? 'Save Changes' : 'Create Page' %></button>
        <a href="/admin/pages" class="btn btn-secondary">Cancel</a>
      </div>
    </form>
  </main>
</div>

<%- include('../partials/footer') %>
